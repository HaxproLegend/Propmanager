# Local demo uses SQLite. For hosted Postgres (e.g. Neon), set DATABASE_URL
# instead and leave DATABASE_PATH unused:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_PATH=backend/instance/propmanager.sqlite3
# Secure cookies are the default for hosted HTTPS deployments.
# Set this to false ONLY for local HTTP development on localhost.
COOKIE_SECURE=true
